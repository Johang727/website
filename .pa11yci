{
  "defaults": {
    "runners": [
      "axe"
    ],
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-dev-shm-usage"
      ]
    },
    "timeout": 60000,
    "ignore": [
      "video-caption",
      "color-contrast"
    ]
  }
}