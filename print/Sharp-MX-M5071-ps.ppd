*% **** Job Offset *************************************************************
*OpenUI *ARJobOffset/Offset: PickOne
*OrderDependency: 290 AnySetup *ARJobOffset
*DefaultARJobOffset: OffsetOn
*ARJobOffset OffsetOff/Off: "
	<</JobOffset 0>> setpagedevice

	userdict /ARRipStyle known not {userdict /ARRipStyle 0 put} if
	userdict /ARCPPriority known not {userdict /ARCPPriority 0 put} if
	userdict /ARCMode known not {userdict /ARCMode 0 put} if
	[{
	ARRipStyle 1 eq ARCPPriority 0 ne and
		{<</ProcessColorModel /DeviceRGB>> setpagedevice}
		{	ARCMode 2 eq
				{<</ProcessColorModel /DeviceGray>> setpagedevice}
				{<</ProcessColorModel /DeviceCMYK>> setpagedevice} ifelse
		} ifelse
	} stopped cleartomark

	userdict /ARSaveToner known not {userdict /ARSaveToner 0 put} if
	[{
	<</PostRenderingEnhance true /TonerSave ARSaveToner>> setpagedevice
	} stopped cleartomark

	[{
	ARCPPriority 2 eq
		{<</HWResolution [1200 1200]>> setpagedevice}
		{<</HWResolution [600 600]>> setpagedevice} ifelse
	ARCPPriority 1 eq
		{<</PixelDepth 4>> setpagedevice}
		{<</PixelDepth 1>> setpagedevice} ifelse
	} stopped cleartomark

	userdict /ARCSharpness known not {userdict /ARCSharpness 0 put} if
	[{
	ARCSharpness setsharpness
	} stopped cleartomark

	userdict /ARFineText known not {userdict /ARFineText 0 put} if
	ARCPPriority 0 eq {userdict /ARFineText 0 put} if
	ARFineText 0 eq
		{userdict /ARCScreen known not {userdict /ARCScreen 0 put} if}
		{userdict /ARCScreen known not {userdict /ARCScreen 8 put} if} ifelse
	[{
	ARCScreen setscreentype
	} stopped cleartomark

	[{
	ARTextLineControl settxtlinectrl
	} stopped cleartomark

	[{
	ARTextLineKnockout settxtlineknockctrl
	} stopped cleartomark

	[{
	AREEnhancement setedgeenhancement AREEnhanceValue setedgeenhancementvalue
	} stopped cleartomark"
*End
*ARJobOffset OffsetOn/Offset each set: "
	<</JobOffset 1>> setpagedevice

	userdict /ARRipStyle known not {userdict /ARRipStyle 0 put} if
	userdict /ARCPPriority known not {userdict /ARCPPriority 0 put} if
	userdict /ARCMode known not {userdict /ARCMode 0 put} if
	[{
	ARRipStyle 1 eq ARCPPriority 0 ne and
		{<</ProcessColorModel /DeviceRGB>> setpagedevice}
		{	ARCMode 2 eq
				{<</ProcessColorModel /DeviceGray>> setpagedevice}
				{<</ProcessColorModel /DeviceCMYK>> setpagedevice} ifelse
		} ifelse
	} stopped cleartomark

	userdict /ARSaveToner known not {userdict /ARSaveToner 0 put} if
	[{
	<</PostRenderingEnhance true /TonerSave ARSaveToner>> setpagedevice
	} stopped cleartomark

	[{
	ARCPPriority 2 eq
		{<</HWResolution [1200 1200]>> setpagedevice}
		{<</HWResolution [600 600]>> setpagedevice} ifelse
	ARCPPriority 1 eq
		{<</PixelDepth 4>> setpagedevice}
		{<</PixelDepth 1>> setpagedevice} ifelse
	} stopped cleartomark

	userdict /ARCSharpness known not {userdict /ARCSharpness 0 put} if
	[{
	ARCSharpness setsharpness
	} stopped cleartomark

	userdict /ARFineText known not {userdict /ARFineText 0 put} if
	ARCPPriority 0 eq {userdict /ARFineText 0 put} if
	ARFineText 0 eq
		{userdict /ARCScreen known not {userdict /ARCScreen 0 put} if}
		{userdict /ARCScreen known not {userdict /ARCScreen 8 put} if} ifelse
	[{
	ARCScreen setscreentype
	} stopped cleartomark

	[{
	ARTextLineControl settxtlinectrl
	} stopped cleartomark

	[{
	ARTextLineKnockout settxtlineknockctrl
	} stopped cleartomark

	[{
	AREEnhancement setedgeenhancement AREEnhanceValue setedgeenhancementvalue
	} stopped cleartomark"
*End
*CloseUI: *ARJobOffset
*% *****************************************************************************

